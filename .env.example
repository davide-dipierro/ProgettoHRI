# =============================================================================
# HRI Poker Experiment - Template Configurazione
# =============================================================================
# Copia questo file come .env e modifica i valori secondo il tuo setup.
#   copy .env.example .env
# =============================================================================

# --- Connessione robot NAO ---
NAO_IP=127.0.0.1
NAO_PORT=50683
SIMULATION_MODE=true

# --- Python 2.7 (necessario per NAOqi SDK con robot reale) ---
PYTHON27_PATH=C:\Python27\python.exe

# --- Path SDK Choregraphe ---
NAOQI_SDK_PATH=C:\Program Files (x86)\Aldebaran Robotics\Choregraphe Suite 2.1\lib

# --- Server Flask ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# --- Parametri di gioco ---
STARTING_CHIPS=1000
SMALL_BLIND=10
BIG_BLIND=20
ROBOT_THINK_TIME_MIN=1
ROBOT_THINK_TIME_MAX=2
